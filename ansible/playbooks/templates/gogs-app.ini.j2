RUN_USER = git
RUN_MODE = prod

[server]
DOMAIN = git.{{ stack_domain }}
EXTERNAL_URL = https://git.{{ stack_domain }}/
HTTP_PORT = 3000
SSH_PORT = {{ gogs_ssh_port }}

[repository]
DEFAULT_BRANCH = main
ROOT = /data/git/gogs-repositories

[mirror]
DEFAULT_INTERVAL = {{ mirror_interval_hours }}

[database]
TYPE = sqlite3
PATH = /data/gogs/data/gogs.db

[security]
INSTALL_LOCK = true
SECRET_KEY = {{ gogs_secret_key }}

[auth]
DISABLE_REGISTRATION = true

[log]
MODE = console
ROOT_PATH = /data/gogs/log
