# Copy to terraform.tfvars (gitignored) and fill in. Secrets stay in the environment.

ssh_public_key    = "ssh-ed25519 AAAA... key-comment"
duckdns_subdomain = "example"
image_server_url  = "http://192.168.1.10:8000"

