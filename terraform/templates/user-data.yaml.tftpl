#cloud-config
hostname: ${hostname}
manage_etc_hosts: true

users:
  - name: freebox
    groups: [sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${jsonencode(ssh_public_key)}

packages:
  - python3

write_files:
  # sshd uses the first value it reads, so this must sort before 50-cloud-init.conf.
  - path: /etc/ssh/sshd_config.d/10-freebox.conf
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password

runcmd:
  - systemctl restart ssh
